@EnglishAdventure.Api_HostAddress = http://localhost:5063

GET {{EnglishAdventure.Api_HostAddress}}/health

###

POST {{EnglishAdventure.Api_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "parent@example.com",
  "password": "<password>"
}

###

POST {{EnglishAdventure.Api_HostAddress}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "<refresh token from login>"
}

###

POST {{EnglishAdventure.Api_HostAddress}}/api/v1/auth/logout
Content-Type: application/json

{
  "refreshToken": "<refresh token>"
}

###

GET {{EnglishAdventure.Api_HostAddress}}/api/v1/auth/me
Authorization: Bearer <access token>

###

# Web client mode (B-F1): the refresh token goes into the httpOnly cookie "ea_refresh" and the body's
# refreshToken is null. Refresh and logout then send no body, only this header and the cookie.
POST {{EnglishAdventure.Api_HostAddress}}/api/v1/auth/login
Content-Type: application/json
X-EnglishAdventure-Client: web

{
  "email": "parent@example.com",
  "password": "<password>"
}

###

# Development only: creates the database if needed and applies pending migrations.
POST {{EnglishAdventure.Api_HostAddress}}/api/v1/database/migrate

###

# Requires the roles.manage permission (SuperAdmin).
GET {{EnglishAdventure.Api_HostAddress}}/api/v1/admin/permissions
Authorization: Bearer <access token>

###

# ---- User management (sign in as SuperAdmin first) ----

GET {{EnglishAdventure.Api_HostAddress}}/api/v1/admin/users?page=1&pageSize=20&search=
Authorization: Bearer <access token>

###

POST {{EnglishAdventure.Api_HostAddress}}/api/v1/admin/users
Authorization: Bearer <access token>
Content-Type: application/json

{
  "email": "content.admin@example.com",
  "password": "<at least 12 chars: upper, lower, digit, symbol>",
  "userType": "Admin"
}

###

PUT {{EnglishAdventure.Api_HostAddress}}/api/v1/admin/users/<user id>/roles
Authorization: Bearer <access token>
Content-Type: application/json

{
  "roles": ["ContentAdmin"]
}

###

POST {{EnglishAdventure.Api_HostAddress}}/api/v1/admin/users/<user id>/deactivate
Authorization: Bearer <access token>

###

POST {{EnglishAdventure.Api_HostAddress}}/api/v1/admin/users/<user id>/activate
Authorization: Bearer <access token>

###
