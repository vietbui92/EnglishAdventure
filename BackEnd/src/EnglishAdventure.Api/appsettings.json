{
  "ConnectionStrings": {
    "EnglishAdventure": "Server=(localdb)\\mssqllocaldb;Database=EnglishAdventure;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "EnglishAdventure.Api",
      "Audience": "EnglishAdventure.Clients",
      "AccessTokenLifetimeMinutes": 15
    },
    "RefreshToken": {
      "LifetimeDays": 14
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
